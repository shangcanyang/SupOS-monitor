{
  "name": "supos-monitor",
  "version": "1.0.0",
  "description": "supOS 测点监控告警 · Windows 桌面常驻应用",
  "main": "src/main/index.js",
  "author": "shangcanyang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "pack": "electron-builder --win zip --x64",
    "pack:dir": "electron-builder --win dir --x64",
    "publish": "electron-builder --win zip --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.24",
    "nodemailer": "^6.9.14",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shangcanyang.supos-monitor",
    "productName": "SupOS-monitor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.zip"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shangcanyang",
        "repo": "SupOS-monitor",
        "releaseType": "release"
      }
    ]
  }
}
