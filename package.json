{
  "name": "supos-monitor",
  "version": "1.0.0",
  "description": "supOS 测点监控告警 · Windows 桌面常驻应用",
  "main": "src/main/index.js",
  "author": "shangcanyang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "pack": "electron-builder --win zip --x64",
    "pack:dir": "electron-builder --win dir --x64",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always",
    "publish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "imapflow": "^2.0.2",
    "mailparser": "^3.9.25",
    "nodemailer": "^10.0.8",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.shangcanyang.supos-monitor",
    "productName": "SupOS-monitor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.zip"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SupOS-monitor",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shangcanyang",
        "repo": "SupOS-monitor",
        "releaseType": "release"
      }
    ]
  }
}
